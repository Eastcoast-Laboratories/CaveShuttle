# Deployment target configuration for dev/deploy.sh
REMOTE_USER="ssh-user"
REMOTE_HOST="user@host"
REMOTE_PATH="/var/www/path/to/deploy/"
REMOTE_CHOWN_USER="owner-user"
REMOTE_CHOWN_GROUP="owner-group"

# Scaleway Mac mini for iOS builds (macos-build-setup.sh, dev/plans)
MAC_HOST="user@your-mac-host"
MAC_PASSWORD_FILE="/path/to/mac-password.txt"
APPLE_ID="you@example.com"
